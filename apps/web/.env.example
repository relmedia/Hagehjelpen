# Kopier til .env.local og fyll inn verdiene.

# E-post fra kontaktskjemaet. Uten RESEND_API_KEY faller skjemaet tilbake til
# å åpne kundens e-postklient med en ferdig utfylt melding (uten vedlegg).
RESEND_API_KEY=
CONTACT_TO=post@hagehjelpen.no
CONTACT_FROM=Hagehjelpen <post@hagehjelpen.no>

# Cal.com-lenke for booking av befaring, på formen "brukernavn/arrangement".
# Er den tom, viser befaringsseksjonen telefon og skjema i stedet for kalender.
NEXT_PUBLIC_CAL_LINK=

# Innhold fra dashbordet (robotklippere i produktvelgeren). Uten disse bruker
# nettsiden modellene som er innebygd i src/lib/mowers.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Salt for besøks-id-en i trafikkmålingen. Sett en tilfeldig streng i produksjon
# slik at id-ene ikke kan gjettes. Uten den brukes en fast standardverdi.
ANALYTICS_SALT=

# Flyfoto fra Norkart i plenoppmålingen. Uten egen nøkkel brukes Norkarts
# åpne demonøkkel – skaff egen nøkkel fra norkart.no før produksjon.
NEXT_PUBLIC_NORKART_API_KEY=
