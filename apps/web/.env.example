# Kopier til .env.local og fyll inn verdiene.

# Serverhemmelighet som lar kontaktskjemaet lagre henvendelser i «Henvendelser»
# og hente e-postoppsettet fra dashbordet. Eksponeres aldri i nettleseren.
SUPABASE_SECRET_KEY=

# Reserve for e-post fra kontaktskjemaet. Er SUPABASE_SECRET_KEY satt, hentes
# nøkkel og avsender fra Innstillinger → E-post i dashbordet i stedet. Uten noen
# av delene faller skjemaet tilbake til å åpne kundens e-postklient.
RESEND_API_KEY=
CONTACT_TO=post@hagehjelpen.no
CONTACT_FROM=Hagehjelpen <post@hagehjelpen.no>

# Brukes i lenker og bunntekst i e-postene.
NEXT_PUBLIC_SITE_URL=https://hagehjelpen.no

# Cloudflare Turnstile (robotsjekk i kontaktskjemaet). Hent nøklene under
# Turnstile i Cloudflare-dashbordet. Uten TURNSTILE_SECRET_KEY hopper serveren
# over sjekken, og uten sitekey vises ingen widget – da virker skjemaet som før.
# Testnøkler fra Cloudflare: 1x00000000000000000000AA godtar alt,
# 2x00000000000000000000AB avviser alt.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cal.com-lenke for booking av befaring, på formen "brukernavn/arrangement".
# Er den tom, viser befaringsseksjonen telefon og skjema i stedet for kalender.
NEXT_PUBLIC_CAL_LINK=

# Innhold fra dashbordet (robotklippere i produktvelgeren). Uten disse bruker
# nettsiden modellene som er innebygd i src/lib/mowers.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Salt for besøks-id-en i trafikkmålingen. Sett en tilfeldig streng i produksjon
# slik at id-ene ikke kan gjettes. Uten den brukes en fast standardverdi.
ANALYTICS_SALT=

# Flyfoto fra Norkart i plenoppmålingen. Uten egen nøkkel brukes Norkarts
# åpne demonøkkel – skaff egen nøkkel fra norkart.no før produksjon.
NEXT_PUBLIC_NORKART_API_KEY=
